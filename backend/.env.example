# Base de datos (MongoDB Atlas gratis). Sin ella, las partidas solo viven en memoria.
MONGODB_URI=mongodb+srv://usuario:contraseña@cluster.mongodb.net/traidores
# Clave para firmar las sesiones. Cámbiala: si cambia, todos tendrán que volver a entrar.
JWT_SECRET=una_clave_larga_y_secreta
PORT=4000
# Opcional
CORS_ORIGIN=*
